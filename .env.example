# --- Front (build) ---
# Opcional. Sem isso, o app chama a API da Anthropic direto do navegador com a
# chave que o usuário digita na barra superior (fica só no localStorage dele).
# Com isso definido, o campo de chave vira "código de acesso" e tudo passa pelo
# seu backend. No Netlify já vem definido pelo netlify.toml.
VITE_API_PROXY_URL=/api/gerar

# --- Backend (função serverless ou server/proxy.mjs) ---
# Nunca versione estes valores; defina-os no painel do Netlify.
ANTHROPIC_API_KEY=sk-ant-...
# Exigido pelas funções do Netlify: sem ele, nenhuma geração é aceita.
CODIGO_ACESSO=escolha-um-codigo

# --- Malha 3D generativa (opcional, função /api/malha) ---
# Sem MALHA_API_KEY, o botão "Gerar malha 3D" responde explicando o que falta;
# o resto do app segue funcionando.
MALHA_API_KEY=
MALHA_PROVEDOR=tripo
# Domínios de onde a função aceita baixar o modelo pronto. Sem esta lista ela
# viraria um proxy aberto para buscar qualquer URL.
MALHA_DOMINIOS=tripo3d.ai,tripo-data.rg1.data.tripo3d.com
